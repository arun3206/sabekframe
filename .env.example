# Required after deployment; optional for the initial local scaffold.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production value: set this to the final Sab Ek Frame domain or Worker URL.
# Required before launch for customer, refund, and privacy requests.
NEXT_PUBLIC_SUPPORT_EMAIL=

# AWS upload integration (CDK outputs these resource names).
# Keep `memory` for offline development; use `aws` to test against the dev stack.
UPLOAD_STORAGE_PROVIDER=memory
AWS_REGION=ap-south-1
# Local AWS CLI/CDK profile. The Worker signer reads short-lived credentials from
# the process environment or encrypted Cloudflare secrets instead.
AWS_PROFILE=
AWS_RAW_UPLOADS_BUCKET=
AWS_SANITIZED_UPLOADS_BUCKET=
AWS_UPLOADS_TABLE=
AWS_UPLOAD_FINALIZER_FUNCTION=
AWS_PROVIDER_SECRETS_ID=
RAZORPAY_MODE=TEST
AWS_RAZORPAY_SECRET_ID=ai-photo-generator/razorpay/test

# Use `memory` locally or `dynamodb` with the AWS development stack.
RATE_LIMIT_PROVIDER=memory
# Optional manual cleanup endpoint secret. Scheduled AWS cleanup does not use it.
UPLOAD_CLEANUP_SECRET=

# Magic Hour is used server-side for template face detection and face swap.
# Never prefix the key with NEXT_PUBLIC_ or commit the real value.
MAGIC_HOUR_API_KEY=<your-key>
MAGIC_HOUR_BASE_URL=https://api.magichour.ai

# OpenAI is used server-side only for Janmashtami Krishna image editing.
# Never prefix the key with NEXT_PUBLIC_ or commit the real value.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Razorpay one-time portrait purchase. RAZORPAY_MODE must match the key prefix.
# In deployed AWS environments, store all three secrets in AWS_RAZORPAY_SECRET_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_PORTRAIT_PRICE=2900

# RevenueCat hosted Web Purchase Link. Use the Sandbox URL in development and
# the Production URL in production. Anonymous purchases require Redemption Links.
NEXT_PUBLIC_REVENUECAT_PURCHASE_URL=

# Server-only RevenueCat webhook authorization value (not used yet).
REVENUECAT_WEBHOOK_AUTHORIZATION=
